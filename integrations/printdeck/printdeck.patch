+package main
+
+// The pen plotter of the deck: an accessory machine next to the 3D printer. The deck mounts
+// plotstudio (the bed scan with the camera of the deck, the layout, the pens and the plot) at
+// /plotter/ behind the login of the remote screen. plotter.json in the state folder turns it on:
+//
+//	{"addr": "penplotter.local", "camera": "", "travelX": 245, "travelY": 395}
+//
+// "camera" selects the camera of the deck: "" for the main camera, a role, a number or an ID.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"log"
+	"net/http"
+	"os"
+	"path/filepath"
+
+	"github.com/beetlebugorg/penplotter/integrations/printdeck/plotter"
+
+	"printdeck/internal/config"
+	"printdeck/internal/remote"
+	"printdeck/internal/ui"
+)
+
+// plotterSetting is plotter.json.
+type plotterSetting struct {
+	Addr    string  `json:"addr"`
+	Camera  string  `json:"camera"`
+	TravelX float64 `json:"travelX"`
+	TravelY float64 `json:"travelY"`
+}
+
+// registerPlotter mounts the plotter when plotter.json names one, and returns it, or nil.
+func registerPlotter(mux *http.ServeMux, rs *remote.Server, cfg config.Config, app *ui.App) *plotter.Plotter {
+	b, err := os.ReadFile(filepath.Join(cfg.StateDir, "plotter.json"))
+	if err != nil {
+		return nil
+	}
+	var s plotterSetting
+	if err := json.Unmarshal(b, &s); err != nil {
+		log.Printf("plotter: plotter.json: %v", err)
+		return nil
+	}
+	pc := plotter.Config{Addr: s.Addr, DataDir: filepath.Join(cfg.StateDir, "plotter"),
+		TravelX: s.TravelX, TravelY: s.TravelY, CameraName: "printdeck " + s.Camera}
+	if app != nil {
+		// The camera is found at each picture: the hub of the deck can start after the web pages.
+		pc.Snapshot = func(ctx context.Context) ([]byte, error) {
+			if app.Camera == nil {
+				return nil, errors.New("the deck has no camera")
+			}
+			src, ok := app.Camera.Source(s.Camera)
+			if !ok {
+				return nil, errors.New("the deck has no camera " + s.Camera)
+			}
+			f, err := src.Snapshot(ctx)
+			if err != nil {
+				return nil, err
+			}
+			return f.JPEG(), nil
+		}
+	}
+	p := plotter.New(pc)
+	h := http.StripPrefix("/plotter", p.Handler())
+	mux.HandleFunc("/plotter/", rs.Auth(h.ServeHTTP))
+	mux.HandleFunc("GET /plotter", func(w http.ResponseWriter, r *http.Request) {
+		http.Redirect(w, r, "/plotter/", http.StatusFound)
+	})
+	log.Printf("plotter: %s at /plotter/", s.Addr)
+	return p
+}
